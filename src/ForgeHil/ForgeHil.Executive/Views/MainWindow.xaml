<Window x:Class="ForgeHil.Executive.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ForgeHil.Executive.ViewModels"
        xmlns:srv="clr-namespace:ForgeHil.Executive.Services"
        Title="ForgeHIL — Hardware Validation Executive"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="640"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UIFont}">
    <Window.Resources>
        <srv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <srv:NullToVisibilityConverter x:Key="NullToVis" />
        <srv:PassFailConverter x:Key="PassFail" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- title bar -->
            <RowDefinition Height="Auto"/>
            <!-- status strip -->
            <RowDefinition Height="*"/>
            <!-- main panels -->
            <RowDefinition Height="200"/>
            <!-- UART feed -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ─────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="FORGE" Foreground="{StaticResource AccentBrush}"
                 FontSize="18" FontWeight="Bold" Margin="4,0,0,0"/>
            <TextBlock Text="HIL" Foreground="{StaticResource TextPrimaryBrush}"
                 FontSize="18" FontWeight="Light" Margin="4,0,0,0"/>
            <TextBlock Text="Hardware Validation Executive"
                 Foreground="{StaticResource TextSecondaryBrush}"
                 FontSize="12" VerticalAlignment="Bottom" Margin="16,0,0,2"/>
        </StackPanel>

        <!-- ── Status strip ──────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="24">

                <!-- Device indicator -->
                <StackPanel Orientation="Horizontal" Margin="6">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceState}"
                               Value="Connected">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeviceState}"
                               Value="Connecting">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="DEVICE"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                     Text="{Binding DeviceStateLabel}"/>
                </StackPanel>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}"/>

                <!-- Saleae indicator -->
                <StackPanel Orientation="Horizontal" Margin="6">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaleaeConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="SALEAE"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                     Text="{Binding SaleaeStateLabel}"/>
                </StackPanel>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}"/>

                <!-- NATS indicator -->
                <StackPanel Orientation="Horizontal" Margin="6">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NatsState}"
                               Value="Connected">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NatsState}"
                               Value="Reconnecting">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="NATS"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                     Text="{Binding NatsStateLabel}"/>
                </StackPanel>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}"/>

                <!-- Firmware ID -->
                <StackPanel Orientation="Horizontal" Margin="6">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="FIRMWARE"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                     Text="{Binding FirmwareId}"
                     Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ── Main panels ────────────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <!-- left: device + saleae + nats -->
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="260"/>
                <!-- center: scenario -->
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <!-- right: results -->
            </Grid.ColumnDefinitions>

            <!-- ── Left column ─────────────────────────────────────────────────── -->
            <StackPanel Grid.Column="0" Margin="8">

                <!-- Device panel -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="DEVICE"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Port"/>
                            <TextBox   Grid.Row="0" Grid.Column="1"
                         Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FF0A0C12" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Padding="4,2" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                         Text="{Binding DeviceStateLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Last seen"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"
                         Text="{Binding LastSeen}" FontFamily="{StaticResource MonoFont}"
                         FontSize="11"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="6">
                            <Button Style="{StaticResource PrimaryButton}" Content="Connect"
                      Command="{Binding ConnectDeviceCommand}" Padding="12,6"/>
                            <Button Style="{StaticResource DangerButton}"  Content="Disconnect"
                      Command="{Binding DisconnectDeviceCommand}" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Saleae panel -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="SIGNAL CAPTURE"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                         Text="{Binding SaleaeStateLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Last capture"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                         Text="{Binding LastCaptureInfo}" FontSize="11"/>
                        </Grid>

                        <Button Style="{StaticResource PrimaryButton}" Content="Check Health"
                    Command="{Binding CheckSaleaeCommand}" Padding="12,6"
                    HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- NATS panel -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="NATS"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="URL"/>
                            <TextBox   Grid.Row="0" Grid.Column="1"
                         Text="{Binding NatsUrl, UpdateSourceTrigger=PropertyChanged}"
                         Background="#FF0A0C12" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                         Padding="4,2" FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                         Text="{Binding NatsStateLabel}"/>
                        </Grid>

                        <Button Style="{StaticResource PrimaryButton}" Content="Connect"
                    Command="{Binding ConnectNatsCommand}" Padding="12,6"
                    HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ── Scenario panel ───────────────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                     Text="SCENARIO"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="8">
                        <Button Style="{StaticResource PrimaryButton}"
                    Content="▶  Run Scenario"
                    Command="{Binding RunScenarioCommand}"
                    IsEnabled="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Stretch"/>
                        <Button Style="{StaticResource DangerButton}"
                    Content="■  Cancel"
                    Command="{Binding CancelRunCommand}"
                    HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,12">
                        <StackPanel Margin="4">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Scenario"/>
                            <ComboBox ItemsSource="{Binding Scenarios}"
                        SelectedItem="{Binding SelectedScenario}"
                        DisplayMemberPath="Name"/>
                        </StackPanel>

                        <!-- Selected scenario details -->
                        <Border Background="#FF0A0C12" CornerRadius="4" Padding="8" 
                                Visibility="{Binding SelectedScenario, Converter={StaticResource NullToVis}}">
                            <StackPanel Margin="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="20"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Sensor mode"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                             Text="{Binding SelectedScenario.SensorMode}"
                             FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Fault"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                             Text="{Binding SelectedScenario.FaultInjection}"
                             FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Duration"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"
                             Text="{Binding SelectedScenario.DurationSeconds, StringFormat={}{0}s}"
                             FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Running indicator -->
                        <Border Background="#1A00D4FF" CornerRadius="4" Padding="8"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="● RUNNING"
                         Foreground="{StaticResource AccentBrush}"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Results panel ────────────────────────────────────────────────── -->
            <Border Grid.Column="4" Style="{StaticResource CardPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                     Text="RESULTS"/>
                    <ListView ItemsSource="{Binding Results}"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="90"
                                DisplayMemberBinding="{Binding ExecutedAt, StringFormat=HH:mm:ss}"/>
                                <GridViewColumn Header="Scenario" Width="160"
                                DisplayMemberBinding="{Binding ScenarioName}"/>
                                <GridViewColumn Header="Result" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Passed, Converter={StaticResource PassFail}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                <Setter Property="Foreground"
                                        Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Passed}" Value="False">
                                                                <Setter Property="Foreground"
                                        Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Pulses" Width="60"
                                DisplayMemberBinding="{Binding SignalCapture.PulseCount}"/>
                                <GridViewColumn Header="Avg µs" Width="70"
                                DisplayMemberBinding="{Binding SignalCapture.AvgPulseWidthUs, StringFormat=F1}"/>
                                <GridViewColumn Header="Failure"
                                DisplayMemberBinding="{Binding FailureReason}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ── UART feed ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Style="{StaticResource CardPanel}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}"
                   Text="UART FEED" Margin="12,8,12,4"/>
                <TextBox Style="{StaticResource LogBox}"
                 Text="{Binding UartLog, Mode=OneWay}"
                 x:Name="UartLogBox"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
