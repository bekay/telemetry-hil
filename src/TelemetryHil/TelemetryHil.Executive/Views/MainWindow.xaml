<Window x:Class="TelemetryHil.Executive.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:srv="clr-namespace:TelemetryHil.Executive.Services"
        Title="TelemetryHIL — Hardware Validation Executive"
        Width="1280" Height="960"
        MinWidth="1000" MinHeight="720"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UIFont}">

    <Window.Resources>
        <srv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <srv:NullToVisibilityConverter    x:Key="NullToVis"/>
        <srv:PassFailConverter            x:Key="PassFail"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- title bar      -->
            <RowDefinition Height="Auto"/>
            <!-- status strip   -->
            <RowDefinition Height="Auto"/>
            <!-- sensor strip   -->
            <RowDefinition Height="Auto"/>
            <!-- anomaly banner -->
            <RowDefinition Height="*"/>
            <!-- main panels    -->
            <RowDefinition Height="180"/>
            <!-- UART feed      -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ──────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="TELEMETRY"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="HIL"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Light"
                       Margin="6,0,0,0"/>
            <TextBlock Text="Hardware Validation Executive"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11" VerticalAlignment="Bottom"
                       Margin="14,0,0,2"/>
        </StackPanel>

        <!-- ── Status strip ───────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">

                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeviceState}" Value="Connected">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DeviceState}" Value="Connecting">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="DEVICE" Margin="0,0,6,0"/>
                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding DeviceStateLabel}"/>
                </StackPanel>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,0,16,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SaleaeConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="SALEAE" Margin="0,0,6,0"/>
                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding SaleaeStateLabel}"/>
                </StackPanel>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,0,16,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NatsState}" Value="Connected">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NatsState}" Value="Reconnecting">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="NATS" Margin="0,0,6,0"/>
                    <TextBlock Style="{StaticResource FieldValue}" Text="{Binding NatsStateLabel}"/>
                </StackPanel>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="0,0,16,0"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="FIRMWARE" Margin="0,0,6,0"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding FirmwareId}"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ── Sensor strip ───────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource CardPanel}" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="PRESSURE"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding PressureDisplay}"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TEMPERATURE"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding TemperatureDisplay}"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                </StackPanel>

                <Rectangle Grid.Column="3" Fill="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="ROTATION"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding RotationDisplay}"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                </StackPanel>

                <Rectangle Grid.Column="5" Fill="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="DEPTH"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding DepthDisplay}"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                </StackPanel>

                <Rectangle Grid.Column="7" Fill="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="TENSION"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding TensionDisplay}"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                </StackPanel>

                <Rectangle Grid.Column="9" Fill="{StaticResource BorderBrush}"/>

                <StackPanel Grid.Column="10" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="LINE SPEED"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Style="{StaticResource FieldValue}"
                               Text="{Binding LineSpeedDisplay}"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ── Anomaly banner ─────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Margin="0,0,0,6"
                CornerRadius="6"
                BorderThickness="1"
                Padding="12,10"
                Visibility="{Binding AnomalyBannerVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"   Value="#1AFFC107"/>
                    <Setter Property="BorderBrush"  Value="{StaticResource WarningBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBannerCritical}" Value="True">
                            <Setter Property="Background"  Value="#1AFF4B5C"/>
                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: title + detail -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AnomalyBannerTitle}"
                               FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,3">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBannerCritical}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding AnomalyBannerDetail}"
                               Style="{StaticResource FieldLabel}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"/>
                </StackPanel>

                <!-- Right: action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Content="✕  Fail"
                            Command="{Binding AnomalyFailCommand}"
                            Padding="12,6" Margin="0,0,6,0"
                            Style="{StaticResource DangerButton}"/>

                    <Button Content="⚠  Warn + Continue"
                            Command="{Binding AnomalyWarnContinueCommand}"
                            Padding="12,6" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Background" Value="#FF6B4E00"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="↺  Warn + Retest"
                            Command="{Binding AnomalyWarnRetestCommand}"
                            Padding="12,6" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Background" Value="#FF6B4E00"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="—  Dismiss"
                            Command="{Binding AnomalyDismissCommand}"
                            Padding="12,6"
                            Style="{StaticResource PrimaryButton}"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main panels ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: device / saleae / nats ─────────────────────────── -->
            <StackPanel Grid.Column="0">

                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="DEVICE"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Port"/>
                            <TextBox   Grid.Row="0" Grid.Column="1"
                                       Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}"
                                       Background="#FF0A0C12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       BorderBrush="{StaticResource BorderBrush}"
                                       BorderThickness="1" Padding="4,2"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding DeviceStateLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Last seen"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding LastSeen}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Content="Connect"
                                    Command="{Binding ConnectDeviceCommand}"
                                    Padding="12,6" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource DangerButton}" Content="Disconnect"
                                    Command="{Binding DisconnectDeviceCommand}"
                                    Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="SIGNAL CAPTURE"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SaleaeStateLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Last capture"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding LastCaptureInfo}" FontSize="11"/>
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" Content="Check Health"
                                Command="{Binding CheckSaleaeCommand}"
                                Padding="12,6" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="NATS"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="URL"/>
                            <TextBox   Grid.Row="0" Grid.Column="1"
                                       Text="{Binding NatsUrl, UpdateSourceTrigger=PropertyChanged}"
                                       Background="#FF0A0C12"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       BorderBrush="{StaticResource BorderBrush}"
                                       BorderThickness="1" Padding="4,2"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Status"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding NatsStateLabel}"/>
                        </Grid>
                        <Button Style="{StaticResource PrimaryButton}" Content="Connect"
                                Command="{Binding ConnectNatsCommand}"
                                Padding="12,6" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ── Scenario panel ────────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}" Text="SCENARIO"/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Scenario" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Scenarios}"
                                  SelectedItem="{Binding SelectedScenario}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>

                    <!-- Scenario details -->
                    <Border DockPanel.Dock="Top"
                            Background="#FF0A0C12" CornerRadius="4" Padding="8"
                            Margin="0,0,0,8"
                            Visibility="{Binding SelectedScenario, Converter={StaticResource NullToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Mode"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.SensorMode}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Fault"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.FaultInjection}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Duration"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.DurationSeconds, StringFormat={}{0}s}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Pressure"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.SimPressurePsi, StringFormat={}{0:F0} PSI}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Temp"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.SimTemperatureC, StringFormat={}{0:F1} °C}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Rotation"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.SimRotationRpm, StringFormat={}{0:F0} RPM}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Depth"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.SimDepthM, StringFormat={}{0:F0} m}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Tension"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.SimTensionKn, StringFormat={}{0:F1} kN}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                            <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Line speed"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldValue}"
                                       Text="{Binding SelectedScenario.SimLineSpeedMs, StringFormat={}{0:F2} m/s}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Running indicator -->
                    <Border DockPanel.Dock="Top"
                            Background="#1A00D4FF" CornerRadius="4" Padding="8"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="● RUNNING"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Run / Cancel -->
                    <Button DockPanel.Dock="Top"
                            Style="{StaticResource PrimaryButton}"
                            Content="▶  Run Scenario"
                            Command="{Binding RunScenarioCommand}"
                            IsEnabled="{Binding CanRun}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"/>
                    <Button DockPanel.Dock="Top"
                            Style="{StaticResource DangerButton}"
                            Content="■  Cancel"
                            Command="{Binding CancelRunCommand}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"/>

                    <!-- Inject anomaly (stub mode) -->
                    <Button DockPanel.Dock="Top"
                            Content="⚡  Inject Anomaly"
                            Command="{Binding InjectStubAnomalyCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="12,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Background" Value="#FF2A1A00"/>
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF4A3200"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </DockPanel>
            </Border>

            <!-- ── Results panel ─────────────────────────────────────────── -->
            <Border Grid.Column="4" Style="{StaticResource CardPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}" Text="RESULTS"/>
                    <ListView ItemsSource="{Binding Results}"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="75"
                                    DisplayMemberBinding="{Binding ExecutedAt, StringFormat=HH:mm:ss}"/>
                                <GridViewColumn Header="Scenario" Width="155"
                                    DisplayMemberBinding="{Binding ScenarioName}"/>
                                <GridViewColumn Header="Result" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Passed, Converter={StaticResource PassFail}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Passed}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Anomalies" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <!-- Has anomalies — show count in warning color -->
                                                            <DataTrigger Binding="{Binding AnomalyCount}" Value="0">
                                                                <Setter Property="Text" Value="—"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="⚠ " Foreground="{StaticResource WarningBrush}"/>
                                                <Run Text="{Binding AnomalyCount}"
                                                     Foreground="{StaticResource WarningBrush}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Pulses" Width="55"
                                    DisplayMemberBinding="{Binding SignalCapture.PulseCount}"/>
                                <GridViewColumn Header="Avg µs" Width="65"
                                    DisplayMemberBinding="{Binding SignalCapture.AvgPulseWidthUs, StringFormat=F1}"/>
                                <GridViewColumn Header="Failure" Width="150"
                                    DisplayMemberBinding="{Binding FailureReason}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

        </Grid>

        <!-- ── UART feed ───────────────────────────────────────────────────── -->
        <Border Grid.Row="5" Style="{StaticResource CardPanel}" Padding="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Style="{StaticResource SectionHeader}"
                           Text="UART FEED"
                           Margin="12,8,12,4"/>
                <TextBox Style="{StaticResource LogBox}"
                         Text="{Binding UartLog, Mode=OneWay}"
                         x:Name="UartLogBox"
                         TextChanged="UartLogBox_TextChanged"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
